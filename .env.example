# Copy to .env before `docker compose up`.
# Shared HS256 secret used by every TraderX service to validate (and, for services, mint) bearer tokens.
# Generate one with: openssl rand -base64 48
TRADERX_AUTH_SECRET=
# Password accepted by people-service POST /Auth/Login for every user in the mock directory (>= 8 chars).
TRADERX_DEMO_USER_PASSWORD=
# Comma-separated logon ids that receive the ADMIN role (may create accounts / account-user mappings).
TRADERX_ADMIN_USERS=user01
