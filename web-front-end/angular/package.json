{
  "name": "@finos/web-front-end",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "lint": "ng lint",
    "start-prod": "ng serve --host 0.0.0.0 --disable-host-check --configuration=production --port ${WEB_SERVICE_PORT:-18093}",
    "start": "ng serve --host 0.0.0.0 --disable-host-check --port ${WEB_SERVICE_PORT:-18093}",
    "build": "cross-env NG_CLI_ANALYTICS=ci ng build --base-href=. --configuration production --output-path=./dist --aot --output-hashing=all",
    "buildlocal": "cross-env NG_CLI_ANALYTICS=ci ng build --base-href=. --configuration local --output-path=./dist --aot --output-hashing=all",
    "test": "ng test --code-coverage --watch=true",
    "test:ci": "ng test --code-coverage --watch=false --browsers=ChromeHeadlessNoSandbox"
  },
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "dependencies": {
    "@angular/animations": "^22.2.4",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/platform-browser-dynamic": "^22.2.4",
    "@angular/router": "^22.2.4",
    "ag-grid-angular": "^32.3.9",
    "ag-grid-community": "^32.3.9",
    "bootstrap": "^5.3.3",
    "ngx-bootstrap": "^22.0.0",
    "rxjs": "^7.8.2",
    "socket.io-client": "4.8.4",
    "tslib": "^2.9.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/language-service": "^22.2.4",
    "@faker-js/faker": "^10.6.0",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.3.0",
    "karma-junit-reporter": "^2.0.1",
    "typescript": "~6.0.3"
  }
}
