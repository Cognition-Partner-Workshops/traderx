{
  "name": "@finos/traderx-refdata-service",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "npm test -- --watch",
    "test:cov": "npm test -- --coverage",
    "test:debug": "node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "npm test -- --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "~12.3.3",
    "@nestjs/core": "~12.3.3",
    "@nestjs/platform-express": "~12.3.3",
    "@nestjs/swagger": "~12.1.0",
    "@nestjs/terminus": "~12.1.0",
    "csv-reader": "~1.0.12",
    "reflect-metadata": "~0.2.2",
    "rxjs": "~7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "~12.0.11",
    "@nestjs/schematics": "~12.0.12",
    "@nestjs/testing": "~12.3.3",
    "@types/express": "~5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "~26.6.6",
    "@types/supertest": "~7.2.1",
    "@typescript-eslint/eslint-plugin": "~8.72.1",
    "@typescript-eslint/parser": "~8.72.1",
    "eslint": "~10.14.0",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "jest": "~30.5.2",
    "prettier": "~3.9.10",
    "source-map-support": "~0.5.21",
    "supertest": "~7.3.1",
    "ts-jest": "~29.4.15",
    "ts-loader": "~9.6.2",
    "ts-node": "~10.9.2",
    "tsconfig-paths": "~4.2.0",
    "typescript": "~6.0.3",
    "@tsconfig/node26": "~26.0.1",
    "@eslint/js": "~10.0.1",
    "globals": "~17.14.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "glob": "^14.0.3"
  },
  "engines": {
    "node": "26.x"
  }
}
